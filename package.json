{
  "name": "exe101-career-readiness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "test:supabase:local": "node scripts/m1-local-policy-check.mjs",
    "review:preflight": "node scripts/review-preflight.mjs",
    "review:verify": "node scripts/review-verify.mjs",
    "cp2:validate": "node scripts/validate-cp2-evidence.mjs --file docs/CP2_EVIDENCE_REGISTER.md --mode template",
    "cp2:validate:template": "node scripts/validate-cp2-evidence.mjs --file docs/CP2_EVIDENCE_REGISTER.md --mode template",
    "cp2:validate:collected": "node scripts/validate-cp2-evidence.mjs --file docs/CP2_EVIDENCE_REGISTER.md --mode collected",
    "cp2:survey:validate": "node scripts/validate-cp2-survey.mjs",
    "cp2:survey:summarize": "node scripts/summarize-cp2-survey.mjs",
    "cp2:sources:validate": "node scripts/validate-cp2-source-log.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "docx": "9.8.1",
    "mammoth": "^1.13.0",
    "next": "16.3.7",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.1",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.25.0"
}
