# Copy to .env.local for local development. Use only local Supabase values here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# New accounts are opt-in and disabled until explicitly configured.
# Emulator harness supplies demo project/hosts; never point it at a cloud project.
OWNPATH_ACCOUNTS_MODE=disabled
OWNPATH_APP_ORIGIN=http://127.0.0.1:3000
OWNPATH_FIREBASE_PROJECT_ID=demo-ownpath-accounts
OWNPATH_SESSION_DAYS=5
# Server-authorized saved-session quota, integer 1–50 (same read/write/catalog policy).
OWNPATH_SAVED_SESSION_LIMIT=50
# Server-only sandbox settings. No live keys accepted; blank means unavailable.
OWNPATH_SANDBOX_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_ACCOUNT_ID=
