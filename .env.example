# Copy to .env.local for local development. Use only local Supabase values here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# OwnPath CV organization/review LOCAL preview: disabled by default. Never prefix secrets
# with NEXT_PUBLIC_. Choose a Responses strict-JSON-schema compatible model.
# Do not put real credentials in this example or commit a local environment file.
OWNPATH_OPENAI_LOCAL_ENABLED=false
OWNPATH_OPENAI_LOCAL_ORIGIN=http://127.0.0.1:3000
OPENAI_API_KEY=
OPENAI_MODEL=

# Scan/Rewrite only. Existing OpenAI/controlled previews are preserved.
# Explicit opt-in: set these in uncommitted .env.local, never NEXT_PUBLIC_.
OWNPATH_SCAN_PROVIDER=openai
OWNPATH_CLAUDE_LOCAL_ENABLED=false
OWNPATH_CLAUDE_LOCAL_ORIGIN=http://127.0.0.1:4317
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Keep billing disabled for this local live-use integration.
OWNPATH_BILLING_MODE=OFF
